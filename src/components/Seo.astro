---
import { LANG_KEYS, DEFAULT_LANG_KEY, toBasePath, toLocalePath, type LangKey } from '../lib/i18n';

interface Props {
  lang: LangKey;
  title?: string;
  description?: string;
  image?: string;
}

const SITE_TITLE = 'Katsuya Endoh';

const DEFAULT_DESCRIPTIONS: Record<LangKey, string> = {
  en: 'Katsuya Endoh is an artist and programmer based in Tokyo.',
  ja: '東京を拠点に活動するアーティスト、プログラマー',
};

const OG_LOCALES: Record<LangKey, string> = {
  en: 'en_US',
  ja: 'ja_JP',
};

const { lang, title, description, image } = Astro.props;
const siteUrl = Astro.site!.origin;
const basePath = toBasePath(Astro.url.pathname);
const url = `${siteUrl}${toLocalePath(basePath, lang)}`;
const pageTitle = title ? `${title} - ${SITE_TITLE}` : SITE_TITLE;
const pageDescription = (description || DEFAULT_DESCRIPTIONS[lang] || DEFAULT_DESCRIPTIONS[DEFAULT_LANG_KEY])
  .replace(/\s+/g, ' ')
  .trim();
---
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<link rel="canonical" href={url} />
{LANG_KEYS.map((langKey) => (
  <link rel="alternate" hreflang={langKey} href={`${siteUrl}${toLocalePath(basePath, langKey)}`} />
))}
<link rel="alternate" hreflang="x-default" href={`${siteUrl}${basePath}`} />

<meta property="og:type" content={basePath === '/' ? 'website' : 'article'} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={url} />
<meta property="og:locale" content={OG_LOCALES[lang]} />
{LANG_KEYS.filter((langKey) => langKey !== lang).map((langKey) => (
  <meta property="og:locale:alternate" content={OG_LOCALES[langKey]} />
))}
{image && <meta property="og:image" content={image} />}

<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:site" content="@KatsuyaEndoh" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
{image && <meta name="twitter:image" content={image} />}
